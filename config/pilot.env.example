# Copy to the repository-root .env; never commit .env or paste the key into the dashboard.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AUDIT_BUDGET_WARNING_USD=2
# Optional hard cap is disabled; normal runs continue past the warning.
AUDIT_HARD_CAP_USD=
SPACETIME_HOST=https://maincloud.spacetimedb.com
SPACETIME_DB=loophole-knowledge-calhacks-2026
SPACETIME_TOKEN_FILE=.spacetime-varun-token
# Python.org installations on macOS may need this system CA bundle.
SSL_CERT_FILE=/etc/ssl/cert.pem
